---
import Layout from "@/layouts/Layout.astro";
import { getNotes, getNotesDetail } from "@/libs/microcms";
import { Code } from "astro:components";

export async function getStaticPaths() {
  const response = await getNotes({ fields: ["id"] });
  return response.contents.map((note) => ({
    params: { id: note.id },
  }));
}

const { id } = Astro.params as { id: string };
const notes = await getNotesDetail(id, {
  fields: ["id", "title", "publishedAt", "content", "icon", "tags"],
});

// HTMLをパースしてコードブロックを抽出
const codeBlockRegex =
  /<div data-filename="([^"]*)">\s*<pre><code class="language-([^"]*)">([\s\S]*?)<\/code><\/pre>\s*<\/div>/g;
const contentParts: {
  type: "html" | "code";
  content: string;
  lang?: string;
  filename?: string;
}[] = [];

let lastIndex = 0;
let match;

while ((match = codeBlockRegex.exec(notes.content)) !== null) {
  // マッチ前のHTMLを追加
  if (match.index > lastIndex) {
    contentParts.push({
      type: "html",
      content: notes.content.slice(lastIndex, match.index),
    });
  }

  // コードブロックを追加
  const filename = match[1];
  const lang = match[2];

  // HTMLエンティティをデコード（改行とインデントを保持）
  let code = match[3];

  // HTMLエンティティのデコード（&amp; を最後に処理する必要がある）
  code = code
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, "&");

  contentParts.push({
    type: "code",
    content: code,
    lang,
    filename,
  });

  lastIndex = match.index + match[0].length;
}

// 残りのHTMLを追加
if (lastIndex < notes.content.length) {
  contentParts.push({
    type: "html",
    content: notes.content.slice(lastIndex),
  });
}
---

<Layout title={`${notes.title} | Notes`} description={`${notes.content}`}>
  <article>
    <div class="header">
      <div class="icon" aria-hidden="true">{notes.icon}</div>
      <h1 class="title">
        {notes.title}
      </h1>
      <div class="info">
        <div class="column">
          <p class="columnTitle">公開日:</p>
          <time class="date" datetime={notes.publishedAt}>
            {
              notes.publishedAt &&
                new Date(notes.publishedAt).toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })
            }
          </time>
        </div>
        <div class="column">
          <p class="columnTitle">タグ:</p>
          <ul class="columnTags">
            {notes.tags.map((tag) => <li>#{tag.name}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="content">
      {
        contentParts.map((part) => {
          if (part.type === "code") {
            return (
              <div data-filename={part.filename}>
                <Code
                  code={part.content}
                  lang={(part.lang || "plaintext") as any}
                />
              </div>
            );
          } else {
            return <Fragment set:html={part.content} />;
          }
        })
      }
    </div>
    <a class="backLink" href="/notes"> 一覧へ戻る </a>
  </article>
</Layout>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .header {
    padding-bottom: var(--margin-m);
    margin-bottom: var(--margin-l);
    border-bottom: rem(1) solid var(--color-border);
  }

  .icon {
    display: flex;
    flex: 1 0 rem(56);
    align-items: center;
    justify-content: center;
    width: rem(56);
    height: rem(56);
    margin: auto;
    font-size: var(--font-size-heading-1);
    text-align: center;
    background-color: var(--color-secondary);
    border-radius: 50%;
  }

  .title {
    margin-top: var(--margin-l);
    font-size: var(--font-size-heading-1);
    font-weight: 600;
    line-height: var(--line-height-heading-1);
  }

  .info {
    display: flex;
    gap: var(--margin-m);
    margin-top: var(--margin-m);
    margin-bottom: var(--margin-m);
  }

  .columnTitle {
    font-size: var(--font-size-small);
    color: var(--color-secondary);
  }

  .columnTags {
    display: flex;
    gap: var(--margin-xs);
    font-size: var(--font-size-small);
    color: var(--color-text);

    li {
      list-style: none;
    }
  }

  .date {
    display: block;
    font-size: var(--font-size-small);
  }

  .content :global(h2) {
    margin-block: var(--margin-l);
    font-size: var(--font-size-heading-2);
    font-weight: 600;
    line-height: var(--line-height-heading-2);
  }

  .content :global(h3) {
    margin-block: var(--margin-m);
    font-size: var(--font-size-heading-3);
    font-weight: 600;
    line-height: var(--line-height-heading-3);
  }

  .content :global(h4) {
    margin-block: var(--margin-m);
    font-size: var(--font-size-heading-4);
    font-weight: 600;
    line-height: var(--line-height-heading-4);
  }

  .content :global(p) {
    margin-block: var(--margin-s);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
  }

  .content :global(hr) {
    margin: var(--margin-l) 0;
    border-top: rem(1) solid var(--color-border);
  }

  .p-large {
    margin-block: var(--margin-s);
    font-size: var(--font-size-large);
    line-height: var(--line-height-base);
  }

  .p-small {
    margin-block: var(--margin-s);
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
  }

  .border-bottom {
    padding-bottom: var(--margin-xs);
    border-bottom: rem(1) solid var(--color-border);
  }

  .box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--margin-l);
    font-weight: 600;
    color: var(--color-background);
    background-color: var(--color-text);

    &[data-size="xxl"] {
      height: var(--margin-xxl);
      font-weight: 600;
    }

    &[data-size="xl"] {
      height: var(--margin-xl);
    }

    &[data-size="l"] {
      height: var(--margin-l);
    }

    &[data-size="m"] {
      height: var(--margin-m);
    }

    &[data-size="s"] {
      height: var(--margin-s);
    }

    &[data-size="xs"] {
      height: var(--margin-xs);
    }

    &[data-size="xxs"] {
      height: var(--margin-xxs);
    }
  }

  .palletList {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(rem(240), 1fr));
    gap: var(--margin-l);
  }

  :global(pre),
  :global(code) {
    tab-size: 2;
    white-space: pre;
  }

  :global(.astro-code) {
    padding: rem(16);
  }

  .backLink {
    display: block;
    width: fit-content;
    margin-inline: auto;
    margin-top: var(--margin-xl);
    font-size: var(--font-size-base);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: rem(4);
  }
</style>
