---
import Layout from "@/layouts/Layout.astro";
import { getNotesDetail } from "@/libs/microcms";

export const prerender = false;

const { id } = Astro.params as { id: string };
if (!id) throw new Error("id is required");

const url = new URL(Astro.url.href);
const draftKey = url.searchParams.get("draftKey");

if (!draftKey) {
  return Astro.redirect(`/notes/${id}`, 302);
}

Astro.response.headers.set(
  "Cache-Control",
  "no-store, no-cache, max-age=0, must-revalidate",
);

const notes = await getNotesDetail(id, {
  draftKey,
  fields: ["id", "title", "publishedAt", "content", "contents", "icon", "tags"],
});

if (!notes) {
  return Astro.redirect("/404", 302);
}
---

<Layout
  title={`${notes.title} | Notes`}
  description={`${notes.content
    .replace(/<[^>]+>/g, "")
    .replace(/\*/g, "")
    .slice(0, 160)}...`}
  noIndex={true}
>
  <div class="previewBanner" role="status">プレビューモード</div>
  <article>
    <div class="header">
      <div class="icon" aria-hidden="true">{notes.icon}</div>
      <h1 class="title">
        {notes.title}
      </h1>
      <div class="info">
        <div class="column">
          <p class="columnTitle">公開日:</p>
          <time class="date" datetime={notes.publishedAt}>
            {
              notes.publishedAt &&
                new Date(notes.publishedAt).toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })
            }
          </time>
        </div>
        {
          notes.tags.length > 0 && (
            <div class="column">
              <p class="columnTitle">タグ:</p>
              <ul class="columnTags">
                {notes.tags.map((tag) => (
                  <li>#{tag.name}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <div class="content">
      {
        (notes.contents ?? []).map((content) => {
          if (content.body) {
            return <Fragment set:html={content.body} />;
          }
        })
      }
    </div>
    <a class="backLink" href="/notes"> 一覧へ戻る </a>
  </article>
  <script>
    import "prism-themes/themes/prism-a11y-dark.css";
    import Prism from "prismjs";
    import "prismjs/components/prism-bash";
    import "prismjs/components/prism-css";
    import "prismjs/components/prism-javascript";
    import "prismjs/components/prism-json";
    import "prismjs/components/prism-markup";
    import "prismjs/components/prism-scss";
    import "prismjs/components/prism-typescript";

    Prism.highlightAll();

    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));
    const copiedMessage = `<span class="copyTooltipMessage" aria-label="コードをクリップボードにコピーしました">Copied!</span>`;

    const addMessage = function (el: Element) {
      el.classList.add("visible");
      el.innerHTML = copiedMessage;
    };

    const removeMessage = function (el: Element) {
      el.classList.remove("visible");
      el.addEventListener(
        "transitionend",
        () => {
          el.innerHTML = "";
        },
        { once: true },
      );
    };

    for (const codeBlock of codeBlocks) {
      const copyWrapper = document.createElement("span");
      copyWrapper.classList.add("copyWrapper");
      copyWrapper.style.position = "absolute";
      copyWrapper.innerHTML = `
        <button type="button" class="copyButton" aria-label="コードをクリップボードにコピーする">${copyButtonLabel}</button>
        <span class="copyTooltip" aria-live="polite">
        </span>`;
      codeBlock.appendChild(copyWrapper);

      let timeout: ReturnType<typeof setTimeout>;

      const copyButton = copyWrapper.querySelector(".copyButton");
      const copyTooltip = copyWrapper.querySelector(".copyTooltip");

      if (!copyButton || !copyTooltip) continue;

      const handleKeyDown = (event: KeyboardEvent) => {
        if (event.key === "Escape") {
          if (timeout) clearTimeout(timeout);
          removeMessage(copyTooltip);
          document.removeEventListener("keydown", handleKeyDown);
        }
      };

      const handleClick = async () => {
        const codeElement = codeBlock.querySelector("code");
        const code = codeElement?.textContent ?? codeBlock.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          addMessage(copyTooltip);
          document.addEventListener("keydown", handleKeyDown);
          timeout = setTimeout(() => {
            removeMessage(copyTooltip);
            document.removeEventListener("keydown", handleKeyDown);
          }, 3000);
        } catch (err) {
          console.error("Failed to copy text: ", err);
        }
      };
      copyButton.addEventListener("click", handleClick);
    }

    document.querySelectorAll("pre code").forEach((block) => {
      block.setAttribute("tabindex", "0");
    });
  </script>
</Layout>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .header {
    padding-bottom: var(--margin-m);
    margin-bottom: var(--margin-l);
    border-bottom: rem(1) solid var(--color-border);
  }

  .icon {
    display: flex;
    flex: 1 0 rem(56);
    align-items: center;
    justify-content: center;
    width: rem(56);
    height: rem(56);
    margin: auto;
    font-size: var(--font-size-heading-1);
    text-align: center;
    background-color: var(--color-secondary);
    border-radius: 50%;
  }

  .title {
    margin-top: var(--margin-l);
    font-size: var(--font-size-heading-1);
    font-weight: 600;
    line-height: var(--line-height-heading-1);
  }

  .info {
    display: flex;
    gap: var(--margin-m);
    margin-top: var(--margin-m);
    margin-bottom: var(--margin-m);
  }

  .columnTitle {
    font-size: var(--font-size-small);
    color: var(--color-secondary);
  }

  .columnTags {
    display: flex;
    gap: var(--margin-xs);
    font-size: var(--font-size-small);
    color: var(--color-text);

    li {
      list-style: none;
    }
  }

  .date {
    display: block;
    font-size: var(--font-size-small);
  }

  .content :global(p) {
    margin-block: var(--margin-s);
  }

  .content :global(blockquote) {
    padding: var(--margin-m) var(--margin-l);
    margin-block: var(--margin-m);
    font-size: var(--font-size-middle);
    color: var(--color-text);
    background-color: var(--color-border);
    border-left: rem(8) solid var(--color-text);
  }

  .content :global(figure),
  .content > :global(ul),
  .content > :global(ol) {
    margin-block: var(--margin-m);
  }

  .content :global(h2) {
    padding-bottom: var(--margin-xs);
    margin-top: var(--margin-xl);
    margin-bottom: var(--margin-m);
    font-size: var(--font-size-heading-2);
    font-weight: 600;
    line-height: var(--line-height-heading-2);
    border-bottom: rem(1) solid var(--color-border);
  }

  .content :global(h3) {
    margin-top: var(--margin-l);
    margin-bottom: var(--margin-m);
    font-size: var(--font-size-heading-3);
    font-weight: 600;
    line-height: var(--line-height-heading-3);
  }

  .content :global(h4) {
    margin-block: var(--margin-m);
    font-size: var(--font-size-heading-4);
    font-weight: 600;
    line-height: var(--line-height-heading-4);
  }

  .content :global(p) {
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
  }

  .content :global(hr) {
    margin: var(--margin-l) 0;
    border-top: rem(1) solid var(--color-border);
  }

  .content :global(pre),
  .content :global(code) {
    tab-size: 2;
    white-space: pre;
  }

  .content :global(pre[class*="language-"]) {
    position: relative;
    padding: 0;
    margin-block: var(--margin-l);
    overflow: hidden;
    border-radius: rem(5);

    :global(code) {
      display: block;
      width: 100%;
      padding: rem(16);
      overflow: hidden;
      overflow-x: auto;

      &:focus {
        outline: rem(2) solid var(--color-syntax-blue);
        outline-offset: rem(-4);
      }
    }
  }

  .content :global(div[data-filename]) {
    position: relative;
    margin-block: var(--margin-l);

    &::before {
      position: absolute;
      top: rem(0);
      left: rem(0);
      z-index: 2;
      display: block;
      padding: rem(4) rem(8);
      font-size: var(--font-size-small);
      color: #24292e;
      content: attr(data-filename);
      background-color: var(--color-syntax-blue);
      border-radius: 0 0 rem(4);
    }

    :global(pre) :global(code) {
      display: block;
      width: 100%;
      padding: rem(54) rem(16) rem(16);
      overflow: hidden;
      overflow-x: scroll;
    }
  }

  .content :global(.copyWrapper) {
    position: absolute;
    top: rem(-16);
    right: rem(8);
    display: block;
    width: fit-content;
    height: fit-content;
  }

  .content :global(.copyButton) {
    position: relative;
    z-index: 2;
    padding: rem(4) rem(8);
    font-size: var(--font-size-small);
    color: #e1e4e8;
    outline-color: var(--color-syntax-blue);
    border: 1px solid #e1e4e8;
    border-radius: rem(2);
  }

  .content :global(.copyTooltip) {
    opacity: 0;
    transition: opacity 0.3s ease;

    &.visible {
      opacity: 1;
    }
  }

  .content :global(.copyTooltipMessage) {
    position: absolute;
    right: rem(-6);
    bottom: rem(-16);
    padding: rem(4) rem(8);
    font-size: var(--font-size-small);
    color: #24292e;
    background-color: var(--color-syntax-blue);
    border-radius: rem(2);

    &::after {
      position: absolute;
      inset-inline: 0;
      top: rem(-6);
      display: block;
      width: rem(8);
      height: rem(6);
      margin: auto;
      content: "";
      background-color: var(--color-syntax-blue);
      clip-path: polygon(0% 100%, 100% 100%, 50% 0%);
    }
  }

  .content :global(.copyTooltip[aria-hidden="true"]) {
    visibility: hidden;
    opacity: 0;
  }

  .content :global(.copyTooltip[aria-hidden="false"]) {
    visibility: visible;
    opacity: 1;
  }

  .content :global(a) {
    text-decoration: underline;
    text-underline-offset: rem(4);
  }

  .content :global(ol) {
    padding-left: var(--margin-m);
    list-style-position: outside;
    list-style-type: decimal;

    :global(li) {
      position: relative;
      margin-block: var(--margin-xs);
    }
  }

  .content :global(ul) {
    :global(li) {
      position: relative;
      padding-left: var(--margin-m);
      margin-block: var(--margin-xs);

      &::before {
        position: absolute;
        top: rem(13);
        left: 0;
        width: rem(4);
        height: rem(4);
        margin-top: rem(-2);
        content: "";
        background-color: var(--color-text);
        border-radius: 50%;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .content :global(a:hover) {
      color: var(--color-primary);
      text-decoration: none;
    }
  }

  .content :global(p > code) {
    padding: rem(2) rem(4);
    font-size: var(--font-size-middle);
    color: var(--color-syntax-text);
    background-color: var(--color-syntax-bg);
    border-radius: rem(4);
  }

  .p-large {
    margin-block: var(--margin-s);
    font-size: var(--font-size-large);
    line-height: var(--line-height-base);
  }

  .p-small {
    margin-block: var(--margin-s);
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
  }

  .border-bottom {
    padding-bottom: var(--margin-xs);
    border-bottom: rem(1) solid var(--color-border);
  }

  .box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--margin-l);
    font-weight: 600;
    color: var(--color-background);
    background-color: var(--color-text);

    &[data-size="xxl"] {
      height: var(--margin-xxl);
      font-weight: 600;
    }

    &[data-size="xl"] {
      height: var(--margin-xl);
    }

    &[data-size="l"] {
      height: var(--margin-l);
    }

    &[data-size="m"] {
      height: var(--margin-m);
    }

    &[data-size="s"] {
      height: var(--margin-s);
    }

    &[data-size="xs"] {
      height: var(--margin-xs);
    }

    &[data-size="xxs"] {
      height: var(--margin-xxs);
    }
  }

  .palletList {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(rem(240), 1fr));
    gap: var(--margin-l);
  }

  .backLink {
    display: block;
    width: fit-content;
    margin-inline: auto;
    margin-top: var(--margin-xl);
    font-size: var(--font-size-base);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: rem(4);
  }

  @media (hover: hover) and (pointer: fine) {
    .backLink:hover {
      color: var(--color-primary);
      text-decoration: none;
    }
  }

  .content :global(table) {
    margin: var(--margin-xl) 0;
  }

  .content :global(th),
  .content :global(td) {
    padding: var(--margin-xs) var(--margin-m);
    border: 1px solid var(--color-text);
  }

  .content :global(th) {
    background-color: var(--color-border);
  }
</style>
