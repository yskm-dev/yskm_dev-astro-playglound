---
import NoteLink from "@/components/module/NoteLink.astro";
import Pagination from "@/components/module/Pagination.astro";
import Layout from "@/layouts/Layout.astro";
import { getNotes, type Notes } from "@/libs/microcms";
import type { GetStaticPathsOptions } from "astro";
import type { MicroCMSListResponse } from "microcms-js-sdk";

const notes = await getNotes({
  fields: ["id", "title", "icon", "tags", "publishedAt"],
  limit: 10,
});

/**
 * ページネーションのための静的パスを生成
 */
export const getStaticPaths = async ({ paginate }: GetStaticPathsOptions) => {
  const response: MicroCMSListResponse<Pick<Notes, "title">> = await getNotes({
    fields: ["id", "title", "icon", "tags", "publishedAt"],
  });

  /**
   * Astroのpaginate関数を使用してページネーションを設定
   * paginate(response.contents, { pageSize: 3 })
   */
  return paginate(response.contents, { pageSize: 1 });
};

const { page } = Astro.props;
---

<Layout title={`Notes - Page ${page.currentPage}`}>
  {/* page.currentPage = 現在のページ番号*/}
  <h1 class="title">Notes - Page {page.currentPage}</h1>
  <ul class="notesList">
    {
      // ここでpage.dataを使用して現在のページのデータにアクセス
      page.data.map((note) => {
        return (
          <li>
            <NoteLink note={note} />
          </li>
        );
      })
    }
  </ul>
  <Pagination
    data={page.data}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    urlPrev={page.url.prev}
    urlNext={page.url.next}
  />
</Layout>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .main {
    width: 100%;
    max-width: calc(rem(640) + var(--margin-l) * 2);
    padding: 0 var(--margin-l);
    margin: auto;
  }

  .title {
    margin-block: var(--margin-l);
    font-size: var(--font-size-heading-1);
    font-weight: 600;
    line-height: var(--line-height-heading-1);
  }

  .notesList {
    display: grid;
    gap: var(--margin-m);
    margin-top: var(--margin-l);
    margin-bottom: var(--margin-l);
  }
</style>
