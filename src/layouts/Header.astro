---
import Nav from "@/layouts/Nav.astro";
import StyleButton from "@/layouts/StyleButton.astro";
---

<app-header class="header">
  <header class="header__inner">
    <h1 class="name">
      <a href="/" aria-label="yskm_dev"
        ><span aria-hidden="true">yskm_dev</span></a
      >
    </h1>
    <div class="header__links">
      <div class="links">
        <Nav className="nav" label="メインナビゲーション" isHome={true} />
        <StyleButton />
      </div>
      <button
        type="button"
        class="menuButton"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </header>
</app-header>

<script>
  import { customTextShuffle } from "@/utils/customTextSuffle";

  class AppHeader extends HTMLElement {
    private rafId: number | null = null;
    private links: NodeListOf<HTMLAnchorElement> = null!;
    private open: HTMLButtonElement | null = null;
    constructor() {
      super();
    }

    connectedCallback() {
      this.rafId = requestAnimationFrame(() => {
        this.initialized();
      });
    }

    initialized() {
      this.open = this.querySelector(".menuButton");
      this.links = this.querySelectorAll("a");

      this.links.forEach((link) => {
        link.addEventListener("mouseenter", this.handleMouseenter.bind(this));
      });

      this.open?.addEventListener("click", () => {
        this.open?.setAttribute(
          "aria-expanded",
          this.open.getAttribute("aria-expanded") === "true" ? "false" : "true",
        );
        const drawer: HTMLElement | null = document.querySelector("app-drawer");

        if (drawer) {
          drawer.dispatchEvent(
            new CustomEvent("drawerOpen", {
              bubbles: true,
              composed: true,
            }),
          );
        }
      });
    }

    handleMouseenter(e: Event) {
      const target = e.currentTarget as HTMLElement;
      const span = target.querySelector("span");
      const text = target.getAttribute("aria-label");
      if (!text || !span) return;
      customTextShuffle(span, text);
    }
  }

  customElements.define("app-header", AppHeader);
</script>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    width: 100%;

    // background-color: var(--color-header);
    // backdrop-filter: blur(rem(10));
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--margin-m);

    // background-color: var(--color-header);
    // backdrop-filter: blur(rem(10));
  }

  .header__links {
    display: flex;
    gap: var(--margin-m);
    align-items: center;
  }

  @media (hover: hover) {
    .header a:hover {
      color: var(--color-primary);
    }
  }

  .links {
    display: flex;
    gap: var(--margin-m);
    align-items: center;
  }

  .name {
    font-size: var(--font-size-heading-3);
    font-weight: 600;
  }

  .menuButton {
    display: none;
  }
  @include mq-lt("sm") {
    .nav {
      display: none;
    }

    .menuButton {
      position: relative;
      display: block;
      width: rem(40);
      height: rem(40);
      background-color: var(--color-secondary);
      border-radius: rem(4);

      span {
        position: absolute;
        inset: 0;
        display: block;
        width: rem(20);
        height: rem(2);
        margin: auto;
        background-color: var(--color-background);
        border-radius: rem(1);

        &:first-child {
          translate: 0 rem(-4);
        }

        &:last-child {
          translate: 0 rem(4);
        }
      }
    }
  }
</style>
