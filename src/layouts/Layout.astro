---
import Drawer from "@/components/module/Drawer.astro";
import Footer from "@/layouts/Footer.astro";
import Header from "@/layouts/Header.astro";
import "@/styles/globals.scss";
import { getPageInfo, SITE_NAME } from "@/utils/sitemap";

const pathname = Astro.url.pathname;

const pageInfo = getPageInfo(pathname);

const {
  title: _title,
  description: _description,
  noIndex: _noIndex,
} = Astro.props;
const lang = "ja";
const isHome = pageInfo?.isHome;
const title = isHome
  ? pageInfo?.title
  : `${_title || pageInfo.title} | ${SITE_NAME}`;
const description =
  _description || pageInfo.description || "yskm_devのサイトです。";
const isNoIndex = _noIndex || pageInfo?.isNoIndex || false;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {isNoIndex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="og:locale" content="ja_JP" />
    <meta name="og:type" content="website" />
    <meta name="og:title" content={title} />
    <meta name="og:description" content={description} />
    <meta name="og:url" content={Astro.site + pathname} />
    <meta name="og:site_name" content={SITE_NAME} />
    <meta name="og:image" content={Astro.site + "/ogp.png"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    {/* ちらつき防止 */}
    <script is:inline>
      (function () {
        var savedTheme = localStorage.getItem("theme");
        var theme =
          savedTheme === "dark" || savedTheme === "light"
            ? savedTheme
            : "system";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <Drawer />
    <div class="wrapper">
      <Header />
      <main>
        <div class="container">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .header {
    display: block;
  }

  .main {
    width: 100%;
  }

  .container {
    max-width: calc(rem(640) + var(--margin-l) * 2);
    padding: var(--margin-xxl) var(--margin-l) 0;
    margin: auto;
  }
</style>
