---

---

<app-style-button>
  <button
    class="style-button"
    aria-label="見た目を切り替える"
    data-state="light"
    data-style-button
  >
    <span class="switch light">
      <span class="icon" aria-hidden="true">☀️</span>
    </span>
    <span class="switch dark">
      <span class="icon" aria-hidden="true">🌙</span>
    </span>
  </button>
</app-style-button>

<script>
  class AppStyleButton extends HTMLElement {
    private button: HTMLButtonElement | null = null;
    private currentMode: "light" | "dark" = "light";
    private rafId: number | null = null;
    constructor() {
      super();
    }

    connectedCallback() {
      this.rafId = requestAnimationFrame(() => {
        this.initialized();
      });
    }

    initialized() {
      this.button = this.querySelector(".style-button");

      if (localStorage.getItem("theme")) {
        this.currentMode = localStorage.getItem("theme") as "light" | "dark";
        this.button?.setAttribute("data-state", this.currentMode);
      } else {
        const darkModeMediaQuery = window.matchMedia(
          "(prefers-color-scheme: dark)",
        );
        const isDarkMode = darkModeMediaQuery.matches;
        if (isDarkMode) {
          this.currentMode = "dark";
        } else {
          this.currentMode = "light";
        }
      }

      this.update();

      this.button?.addEventListener("click", this.toggleStyle.bind(this));

      // 他のStyleButtonインスタンスからのtheme変更をリッスン
      document.addEventListener("themeChange", ((e: CustomEvent) => {
        if (e.detail.source !== this) {
          this.currentMode = e.detail.theme;
          this.button?.setAttribute("data-state", this.currentMode);
        }
      }) as EventListener);
    }

    update() {
      if (this.button === null) return;
      localStorage.setItem("theme", this.currentMode);
      this.button.setAttribute("data-state", this.currentMode);
      if (this.currentMode === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.setAttribute("data-theme", "light");
      }

      // document全体にイベントをdispatchして他のStyleButtonインスタンスと同期
      document.dispatchEvent(
        new CustomEvent("themeChange", {
          detail: { theme: this.currentMode, source: this },
          bubbles: true,
        }),
      );
    }

    toggleStyle() {
      if (this.button === null) return;
      this.button?.classList.remove("animating");

      this.currentMode = this.currentMode === "light" ? "dark" : "light";
      this.update();
      requestAnimationFrame(() => {
        this.button?.classList.add("animating");
      });
    }
  }

  customElements.define("app-style-button", AppStyleButton);
</script>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  @keyframes rotateOut {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(-90deg);
    }
  }

  @keyframes rotateIn {
    from {
      transform: rotate(90deg);
    }

    to {
      transform: rotate(0deg);
    }
  }

  .style-button {
    position: relative;
    display: flex;
    gap: rem(var(--margin-xs));
    align-items: center;
    width: rem(48);
    height: rem(48);
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background: none;
    background-color: var(--color-background);
    border: none;
    border: rem(1) solid var(--color-border);
    border-radius: 50%;

    &[data-state="light"] {
      .light {
        transform: rotate(0deg);
      }

      .dark {
        transform: rotate(90deg);
      }
    }

    &[data-state="dark"] {
      .light {
        transform: rotate(90deg);
      }

      .dark {
        transform: rotate(0deg);
      }
    }

    &.animating {
      &[data-state="light"] {
        .light {
          animation: rotateIn 0.3s var.$ease-in-out-quart;
        }

        .dark {
          animation: rotateOut 0.3s var.$ease-in-out-quart;
        }
      }

      &[data-state="dark"] {
        .light {
          animation: rotateOut 0.3s var.$ease-in-out-quart;
        }

        .dark {
          animation: rotateIn 0.3s var.$ease-in-out-quart;
        }
      }
    }
  }

  .switch {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: rem(48);
    height: rem(48);
    margin: auto;
    font-size: var(--font-size);
    transform-origin: left bottom;
  }

  .icon {
    font-size: var(--font-size-heading-3);
  }
</style>
