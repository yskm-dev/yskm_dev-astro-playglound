---
interface Props {
  note: {
    id: string;
    title: string;
    icon?: string;
    tags?: { name: string }[];
    publishedAt?: string;
  };
  headingLevel?: 2 | 3 | 4 | 5 | 6;
}

const { note, headingLevel } = Astro.props;
const HeadingTag = `h${headingLevel ?? 2}` as const;
---

<a href={`/notes/${note.id}`} class="link">
  <span class="icon" aria-hidden="true">{note.icon}</span>
  <div class="container">
    <div>
      <time class="date" datetime={note.publishedAt}>
        {
          note.publishedAt &&
            new Date(note.publishedAt).toLocaleDateString("ja-JP", {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            })
        }
      </time>
    </div>
    <HeadingTag class="title">{note.title}</HeadingTag>
    {
      note.tags && note.tags.length > 0 && (
        <div class="tagWrapper">
          <p class="tagHeader">タグ:</p>

          <ul class="tagList">
            {note.tags.map((tag) => (
              <li>{`#${tag.name}`}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</a>

<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .link {
    position: relative;
    display: flex;
    gap: var(--margin-m);
    justify-content: flex-start;
    width: 100%;
    padding: var(--margin-m) var(--margin-m) var(--margin-m)
      calc(var(--margin-m) + rem(56 * 0.5));
    border: rem(1) solid var(--color-border);
    border-radius: rem(8);
    @include mq-lt("md") {
      padding: var(--margin-m) var(--margin-m) var(--margin-m)
        calc(var(--margin-m) + rem(40 * 0.725));
    }
  }

  .icon {
    position: absolute;
    top: rem(56 * 0.25);
    left: rem(56 * -0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    width: rem(56);
    height: rem(56);
    font-size: var(--font-size-heading-1);
    line-height: 1;
    background-color: var(--color-secondary);
    border-radius: 50%;

    @include mq-lt("md") {
      top: rem(40 * 0.25);
      left: rem(-40 * 0.325);
      width: rem(40);
      height: rem(40);
      font-size: var(--font-size-heading-3);
    }
  }

  .date {
    display: block;
    margin-bottom: 0.25rem;
    font-size: var(--font-size-small);
    color: var(--color-secondary);
  }

  .title {
    font-size: var(--font-size-heading-3);
    font-weight: 500;
  }

  .tagWrapper {
    display: flex;
    gap: var(--margin-xs);
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
  }

  .tagHeader {
    color: var(--color-secondary);
  }

  .tagList {
    display: flex;
    flex-wrap: wrap;
    gap: var(--margin-xs);
  }

  .link:hover {
    border-color: var(--color-primary);

    .title {
      color: var(--color-primary);
    }
  }
</style>
