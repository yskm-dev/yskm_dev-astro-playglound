---
import type { Notes } from "@/libs/microcms";
import IconNext from "@/svg/icon_next.svg";
import IconPrev from "@/svg/icon_prev.svg";
import type { MicroCMSContentId, MicroCMSDate } from "microcms-js-sdk";

interface Props {
  data: (Pick<Notes, "title"> & {
    title: string;
  } & MicroCMSContentId &
    MicroCMSDate)[];
  currentPage: number;
  lastPage: number;
  urlPrev: string | null | undefined;
  urlNext: string | null | undefined;
}
const { data, currentPage, lastPage, urlPrev, urlNext } = Astro.props;

// ページネーションの表示設定
const MAX_PAGE_LINKS = 3;
// 表示するページリンクの開始と終了を計算
const startPage = Math.max(1, currentPage - Math.floor(MAX_PAGE_LINKS / 2));
const endPage = Math.min(lastPage, startPage + MAX_PAGE_LINKS - 1);
// 前後に省略記号を表示するかどうかを判定
const hasStartPageLink = startPage > 1;
const hasEndPageLink = endPage < lastPage;
---

<app-pagination aria-label="ページネーション">
  <nav class="pagination" aria-label="ページネーション">
    {/* 前へを表示 */}
    <div class:list={["prev", { invalid: !urlPrev }]} aria-hidden={!urlPrev}>
      {() => {
        if(urlPrev) {
          return (
            <a href={urlPrev} aria-label="前のページへ"> <IconPrev /> </a>
          )
        }
      }}
    </div>
    <ul class="countList">
      {/* 先頭のページリンクを表示 */}
      {
        hasStartPageLink ? (
        <li class="page">
          <a href={`/notes/page/1/`}> 1 </a>
        </li>
        <li class="omission">
          ...
        </li>
        ) : null
      }
      {/* ページ番号のリンクを表示 */}
      {
        (() => {
          return [...Array(lastPage)].map((_, index) => {
            if (index + 1 >= startPage && index < endPage) {
              if( index + 1 === currentPage) {
                return (
                  <li class:list={["page", { current: true }]} aria-current="page">
                    <span> {index + 1} </span>
                  </li>
                );
              }
              return (
                <li class="page">
                  <a href={`/notes/page/${index + 1}/`}> {index + 1} </a>
                </li>
              );
            }
            return null;
          });
        })()
      }
      {
        hasEndPageLink ? (
          <li class="omission">
            ...
          </li>
          <li class="page">
            <a href={`/notes/page/${lastPage}/`}>{lastPage}</a>
          </li>
        ) : null
      }
    </ul>
    {/* 次へを表示 */}
    <div class:list={["next", { invalid: !urlNext }]} aria-hidden={!urlNext}>
      {() => {
        if(urlNext) {
          return (
          <a href={urlNext} aria-label="次のページへ"> <IconNext /> </a>
          )
        }
      }}
    </div>
  </nav>
</app-pagination>


<style lang="scss">
  @use "@/styles/variables" as var;
  @use "@/styles/extension" as *;

  .pagination {
    display: flex;
    gap: var(--margin-xs);
    align-items: center;
    width: fit-content;
    margin: auto;
  }

  .countList {
    display: flex;
    gap: var(--margin-xs);
    align-items: center;
  }

  .page {
    width: rem(36);
    height: rem(36);

    a,
    span {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding-top: rem(2);
    }
  }

  .prev,
  .next {
    width: rem(32);
    height: rem(32);

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;

      svg {
        display: block;
        width: rem(20);
        height: rem(20);
      }
    }
  }

  .ommission {
    display: flex;
    align-items: center;
    justify-content: center;
    height: rem(32);
  }

  .current {
    color: var(--color-primary);
  }

  @media (hover: hover) {
    .page a:hover {
      background-color: var(--color-border);
      border-radius: rem(4);
    }

    .prev a:hover,
    .next a:hover {
      background-color: var(--color-border);
      border-radius: rem(4);
    }
  }
</style>
