{
  "name": "jamstack-blog-test",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:ts": "eslint 'src/**/*.{ts,tsx}'",
    "lint:astro": "eslint 'src/**/*.astro'",
    "lint:prettier": "prettier --check './src/**/*.{astro,js,jsx,ts,tsx,css,scss}'",
    "lint:style": "stylelint 'src/**/*.{css,scss,astro}'",
    "fix:ts": "eslint 'src/**/*.{ts,tsx}' --fix",
    "fix:astro": "eslint 'src/**/*.astro' --fix",
    "fix:prettier": "prettier './src/**/*.{astro,js,jsx,ts,tsx,css,scss}' --write .",
    "fix:style": "stylelint 'src/**/*.{css,scss,astro}' --fix",
    "fix": "npm run fix:ts && npm run fix:prettier && npm run fix:style",
    "lint": "npm run lint:ts && npm run lint:prettier && npm run lint:style"
  },
  "overrides": {
    "react": "npm:@preact/compat@latest",
    "react-dom": "npm:@preact/compat@latest"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.16.12",
    "gsap": "^3.14.2",
    "microcms-js-sdk": "^3.2.0"
  },
  "devDependencies": {
    "@markuplint/astro-parser": "^4.6.22",
    "@typescript-eslint/parser": "^8.53.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "markuplint": "^4.14.0",
    "postcss-html": "^1.8.1",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "sass": "^1.97.3",
    "stylelint": "^17.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.6.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
